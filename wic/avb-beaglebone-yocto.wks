# short-description: Create an AVB dm-verity SD card image for Beaglebone
# long-description: Creates a partitioned SD card image for Beaglebone
# with a vfat boot partition and an AVB dm-verity protected rootfs partition.
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4 --fixed-size 32 --sourceparams="loader=u-boot" --use-uuid
part / --source rootfs-avb-verity --ondisk mmcblk0 --fstype=ext4 --label root --align 4 --use-uuid
bootloader --append="console=ttyS0,115200"
