From f6cd474443716f06ba68e629be45dbb3726178c3 Mon Sep 17 00:00:00 2001
From: Ayoub Zaki <ayoub.zaki@embetrix.com>
Date: Sun, 26 Apr 2026 17:49:51 +0200
Subject: [PATCH] dm verity: add root_hash_sig_hex parameter and
 CONFIG_DM_VERITY_REQUIRE_ROOTHASH_SIG

Add support for passing the root hash PKCS#7 signature as a hex-encoded
DER blob directly on the dm-verity table line via a new optional
parameter "root_hash_sig_hex".  This allows dm-verity root hash
signature verification when using dm-mod.create= on the kernel command
line, without requiring an initramfs to load the signature from a file
or keyring.

The hex string is decoded to binary at table load time and passed to
verify_pkcs7_signature() the same way the existing
root_hash_sig_key_desc path does.

Also add CONFIG_DM_VERITY_REQUIRE_ROOTHASH_SIG Kconfig option.  When
enabled, root hash signature verification is mandatory and cannot be
bypassed.  When disabled, the existing require_signatures module
parameter controls enforcement.

Reference: https://www.lynx.com/blog/dm-verity-without-an-initramfs/

Upstream-Status: Inappropriate

Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>
---
 drivers/md/Kconfig                | 11 +++++
 drivers/md/dm-verity-target.c     | 11 +++++
 drivers/md/dm-verity-verify-sig.c | 68 +++++++++++++++++++++++++++++--
 drivers/md/dm-verity-verify-sig.h | 17 +++++++-
 4 files changed, 103 insertions(+), 4 deletions(-)

diff --git a/drivers/md/Kconfig b/drivers/md/Kconfig
index 3ff87cb4dc49..f4b01f1a47d0 100644
--- a/drivers/md/Kconfig
+++ b/drivers/md/Kconfig
@@ -575,6 +575,17 @@ config DM_VERITY_VERIFY_ROOTHASH_SIG_SECONDARY_KEYRING
 
 	  If unsure, say N.
 
+config DM_VERITY_REQUIRE_ROOTHASH_SIG
+	bool "Require root hash signature verification"
+	depends on DM_VERITY_VERIFY_ROOTHASH_SIG
+	help
+	  If enabled, dm-verity always requires a valid root hash
+	  signature and the require_signatures module parameter is
+	  removed.  If disabled, enforcement is controlled at runtime
+	  via the require_signatures module parameter (default off).
+
+	  If unsure, say N.
+
 config DM_VERITY_FEC
 	bool "Verity forward error correction support"
 	depends on DM_VERITY
diff --git a/drivers/md/dm-verity-target.c b/drivers/md/dm-verity-target.c
index 60e74c0e02f1..d5d75e786bda 100644
--- a/drivers/md/dm-verity-target.c
+++ b/drivers/md/dm-verity-target.c
@@ -1194,6 +1194,17 @@ static int verity_parse_opt_args(struct dm_arg_set *as, struct dm_verity *v,
 				return r;
 			continue;
 
+		} else if (verity_verify_is_hex_sig_opt_arg(arg_name)) {
+			if (only_modifier_opts)
+				continue;
+			r = verity_verify_hex_sig_parse_opt_args(as, v,
+								 verify_args,
+								 &argc,
+								 arg_name);
+			if (r)
+				return r;
+			continue;
+
 		} else if (only_modifier_opts) {
 			/*
 			 * Ignore unrecognized opt, could easily be an extra
diff --git a/drivers/md/dm-verity-verify-sig.c b/drivers/md/dm-verity-verify-sig.c
index 1ced2ef255f3..d6d26d95701e 100644
--- a/drivers/md/dm-verity-verify-sig.c
+++ b/drivers/md/dm-verity-verify-sig.c
@@ -14,13 +14,15 @@
 
 #define DM_VERITY_VERIFY_ERR(s) DM_VERITY_ROOT_HASH_VERIFICATION " " s
 
+#ifdef CONFIG_DM_VERITY_REQUIRE_ROOTHASH_SIG
+#define DM_VERITY_IS_SIG_FORCE_ENABLED() (true)
+#else
 static bool require_signatures;
 module_param(require_signatures, bool, 0444);
 MODULE_PARM_DESC(require_signatures,
 		"Verify the roothash of dm-verity hash tree");
-
-#define DM_VERITY_IS_SIG_FORCE_ENABLED() \
-	(require_signatures != false)
+#define DM_VERITY_IS_SIG_FORCE_ENABLED() (require_signatures != false)
+#endif
 
 bool verity_verify_is_sig_opt_arg(const char *arg_name)
 {
@@ -28,6 +30,12 @@ bool verity_verify_is_sig_opt_arg(const char *arg_name)
 			    DM_VERITY_ROOT_HASH_VERIFICATION_OPT_SIG_KEY));
 }
 
+bool verity_verify_is_hex_sig_opt_arg(const char *arg_name)
+{
+	return (!strcasecmp(arg_name,
+			    DM_VERITY_ROOT_HASH_VERIFICATION_OPT_SIG_HEX));
+}
+
 static int verity_verify_get_sig_from_key(const char *key_desc,
 					struct dm_verity_sig_opts *sig_opts)
 {
@@ -102,6 +110,60 @@ int verity_verify_sig_parse_opt_args(struct dm_arg_set *as,
 	return 0;
 }
 
+int verity_verify_hex_sig_parse_opt_args(struct dm_arg_set *as,
+					 struct dm_verity *v,
+					 struct dm_verity_sig_opts *sig_opts,
+					 unsigned int *argc,
+					 const char *arg_name)
+{
+	struct dm_target *ti = v->ti;
+	const char *hex_sig;
+	size_t hex_len, sig_len;
+
+	if (sig_opts->sig) {
+		ti->error = DM_VERITY_VERIFY_ERR("signature already specified");
+		return -EINVAL;
+	}
+
+	if (!*argc) {
+		ti->error = DM_VERITY_VERIFY_ERR("hex signature value not specified");
+		return -EINVAL;
+	}
+
+	hex_sig = dm_shift_arg(as);
+	(*argc)--;
+
+	hex_len = strlen(hex_sig);
+	if (!hex_len || (hex_len & 1)) {
+		ti->error = DM_VERITY_VERIFY_ERR("invalid hex signature length");
+		return -EINVAL;
+	}
+
+	sig_len = hex_len / 2;
+	sig_opts->sig = kmalloc(sig_len, GFP_KERNEL);
+	if (!sig_opts->sig) {
+		ti->error = DM_VERITY_VERIFY_ERR("cannot allocate signature");
+		return -ENOMEM;
+	}
+
+	if (hex2bin(sig_opts->sig, hex_sig, sig_len)) {
+		ti->error = DM_VERITY_VERIFY_ERR("invalid hex signature");
+		kfree(sig_opts->sig);
+		sig_opts->sig = NULL;
+		return -EINVAL;
+	}
+
+	sig_opts->sig_size = sig_len;
+
+	v->signature_key_desc = kstrdup("hex_sig", GFP_KERNEL);
+	if (!v->signature_key_desc) {
+		ti->error = DM_VERITY_VERIFY_ERR("cannot allocate signature desc");
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
 /*
  * verify_verify_roothash - Verify the root hash of the verity hash device
  *			     using builtin trusted keys.
diff --git a/drivers/md/dm-verity-verify-sig.h b/drivers/md/dm-verity-verify-sig.h
index f36ea92127bf..4add735cfea7 100644
--- a/drivers/md/dm-verity-verify-sig.h
+++ b/drivers/md/dm-verity-verify-sig.h
@@ -10,6 +10,7 @@
 
 #define DM_VERITY_ROOT_HASH_VERIFICATION "DM Verity Sig Verification"
 #define DM_VERITY_ROOT_HASH_VERIFICATION_OPT_SIG_KEY "root_hash_sig_key_desc"
+#define DM_VERITY_ROOT_HASH_VERIFICATION_OPT_SIG_HEX "root_hash_sig_hex"
 
 struct dm_verity_sig_opts {
 	unsigned int sig_size;
@@ -18,16 +19,23 @@ struct dm_verity_sig_opts {
 
 #ifdef CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG
 
-#define DM_VERITY_ROOT_HASH_VERIFICATION_OPTS 2
+#define DM_VERITY_ROOT_HASH_VERIFICATION_OPTS 4
 
 int verity_verify_root_hash(const void *data, size_t data_len,
 			    const void *sig_data, size_t sig_len);
 bool verity_verify_is_sig_opt_arg(const char *arg_name);
+bool verity_verify_is_hex_sig_opt_arg(const char *arg_name);
 
 int verity_verify_sig_parse_opt_args(struct dm_arg_set *as, struct dm_verity *v,
 				    struct dm_verity_sig_opts *sig_opts,
 				    unsigned int *argc, const char *arg_name);
 
+int verity_verify_hex_sig_parse_opt_args(struct dm_arg_set *as,
+					 struct dm_verity *v,
+					 struct dm_verity_sig_opts *sig_opts,
+					 unsigned int *argc,
+					 const char *arg_name);
+
 void verity_verify_sig_opts_cleanup(struct dm_verity_sig_opts *sig_opts);
 
 #else
@@ -52,6 +60,13 @@ static inline int verity_verify_sig_parse_opt_args(struct dm_arg_set *as,
 	return -EINVAL;
 }
 
+static inline int verity_verify_hex_sig_parse_opt_args(struct dm_arg_set *as,
+			struct dm_verity *v, struct dm_verity_sig_opts *sig_opts,
+			unsigned int *argc, const char *arg_name)
+{
+	return -EINVAL;
+}
+
 static inline void verity_verify_sig_opts_cleanup(struct dm_verity_sig_opts *sig_opts)
 {
 }
-- 
