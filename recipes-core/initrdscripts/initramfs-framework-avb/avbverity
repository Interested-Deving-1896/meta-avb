#!/bin/sh

avbverity_enabled() {

    if grep -q "dm-mod.create=" /proc/cmdline; then
        return 1
    fi
    return 0
}

avbverity_run() {

    AVB_VERITY_PUBKEY="/etc/avb/avb_pubkey.bin"
    cmdline_root="$(sed -n 's/.*root=\([^ ]*\).*/\1/p' /proc/cmdline)"
    case "$cmdline_root" in
        LABEL=*)     ROOTDEV="$(readlink -f /dev/disk/by-label/${cmdline_root#LABEL=})" ;;
        PARTLABEL=*) ROOTDEV="$(readlink -f /dev/disk/by-partlabel/${cmdline_root#PARTLABEL=})" ;;
        PARTUUID=*)  ROOTDEV="$(readlink -f /dev/disk/by-partuuid/${cmdline_root#PARTUUID=})" ;;
        UUID=*)      ROOTDEV="$(readlink -f /dev/disk/by-uuid/${cmdline_root#UUID=})" ;;
        /dev/*)      ROOTDEV="$cmdline_root" ;;
        *)           ROOTDEV="" ;;
    esac
    ROOTDEV="${ROOTDEV:-$(readlink -f /dev/disk/by-partlabel/root)}"
    ROOTDEV="${ROOTDEV:-$(readlink -f /dev/disk/by-label/root)}"
    VERITY_DM_NAME="vrootfs"

    if [ -z "${ROOTDEV}" ] || [ ! -b "${ROOTDEV}" ]; then
        fatal "Unable to find root device from kernel cmdline, PARTLABEL=root, or LABEL=root"
    fi

    if [ ! -f "${AVB_VERITY_PUBKEY}" ]; then
        fatal "AVB verity key not found: ${AVB_VERITY_PUBKEY}"
    fi

    dm_table=$(avb_verify --dm-table -d "$ROOTDEV" -k "$AVB_VERITY_PUBKEY") \
        || fatal "Failed to verify root device with AVB"

    echo "$dm_table" | dmsetup create "$VERITY_DM_NAME" --readonly \
        || fatal "dmsetup create failed"

    mount -o ro /dev/mapper/"$VERITY_DM_NAME" ${ROOTFS_DIR} \
        || exit 2
}
